# App
ENVIRONMENT=production
DEBUG=false

# Security — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database (Neon free tier)
# Format: postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL=

# Redis (Upstash free tier)
# Format: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3 (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# CORS — comma-separated, JSON array format
# Add your Vercel deployment URL
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# Sentry (optional)
SENTRY_DSN=
